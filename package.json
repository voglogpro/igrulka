{
  "name": "skyfront-city-defense",
  "version": "8.13.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "dev": "node scripts/dev-server.mjs",
    "multiplayer": "node server/index.mjs",
    "multiplayer:internet": "node server/index.mjs --internet",
    "multiplayer:hosted": "node server/hosted.mjs",
    "build": "node scripts/build-portable.mjs",
    "test": "node --test --test-concurrency=4 tests/unit/*.test.mjs tests/legacy/*.test.mjs",
    "test:soak": "node tests/soak/campaign.mjs",
    "test:browser": "python tests/browser/run.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run build && npm test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.25.12",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "description": "Offline 3D city and air defense strategy",
  "repository": {
    "type": "git",
    "url": "https://github.com/voglogpro/igrulka.git"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "https-proxy-agent": "9.1.0",
    "ws": "8.22.0"
  }
}
